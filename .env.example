# ---------------------------------------------------------------------------
# ShadowSpark Cyberfood — environment variables (all optional at build time)
# ---------------------------------------------------------------------------

# Prisma/PostgreSQL — used by the real backend. NOT queried during static
# prerender/build. Only required to run `prisma generate`/`db:seed`/migrate.
DATABASE_URL="postgresql://shadowspark:shadowspark@localhost:5432/delivery_food?schema=public"

# ---------- AI agent (optional) ----------
# Set these to use the real LLM inside /api/chat. When absent, the chat falls
# back to the rule-based MockLLM from the shared SDK (works with zero keys).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------- Payments (optional) ----------
# Paystack secret key enables real checkout redirects. When empty the checkout
# renders a graceful 'configure Paystack to pay' state.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ---------- Maps (optional) ----------
# Set to render a live Mapbox map; when empty pages use a stylized static
# placeholder that keeps the same component API.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------- Auth (optional, not wired for build) ----------
# Reserved for a future next-auth integration. Builds pass without it.
NEXT_AUTH_SECRET=""
